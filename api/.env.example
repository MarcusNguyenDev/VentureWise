# Copy to `api/.env` and fill in. `api/.env` is gitignored — never commit a key.
#
# Docker Compose substitutes from this directory (api/ is the compose project
# directory), and Nest's ConfigModule reads the same file at runtime, so one
# file covers both.

# ── AI coach ────────────────────────────────────────────────────────────────
# Which implementation of AiCoachPort to bind.
#   stub   fixtures, every result flagged `is_stubbed` — the product runs with
#          no key at all
#   model  ModelAiCoachProvider (OpenAI)
AI_COACH_PROVIDER=stub

OPENAI_API_KEY=

# Cheapest configuration that still does the job, chosen from measured cost
# per call rather than headline rates — reasoning tokens are billed as output,
# which inverts the ranking. gpt-5-nano has the lowest rates of anything here
# and is the MOST expensive in practice: it spent 1,216 reasoning tokens and
# 11.6 s on a single mid-loop call.
#
#   mid loop  gpt-4.1-nano  ~$0.00003/call cached, ~0.9 s. 48 calls a session.
#   slow loop gpt-5.6-luna  only 8 calls a session, and the rewrite is the
#                           demo's key moment, so the better model costs
#                           fractions of a cent here.
#
# Set both to gpt-4.1-nano if you want absolute cheapest and can accept a
# weaker first-person rewrite.
OPENAI_MID_LOOP_MODEL=gpt-4.1-nano
OPENAI_SLOW_LOOP_MODEL=gpt-5.6-luna

# Optional. Set for Azure OpenAI, a gateway, or a local compatible server.
# Leave blank for api.openai.com.
OPENAI_BASE_URL=

# Hard ceiling on a single mid-loop call. The browser skips a tick while a
# request is still out (see the in-flight guard in use_practice_session.ts), so
# a slow call can no longer stack — it just costs one nudge. This can therefore
# be generous. Past ~8 s a nudge describes speech the candidate has moved on
# from, so it is abandoned rather than shown.
OPENAI_MID_LOOP_TIMEOUT_MS=8000

# ── Service ─────────────────────────────────────────────────────────────────
API_PORT=3001
API_DEBUG_PORT=9229
