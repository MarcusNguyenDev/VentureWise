# Shared infrastructure (root docker-compose.yml). Copy to `.env` to override.
MONGO_USER=root
MONGO_PASSWORD=example
MONGO_DB=venturewise
MONGO_PORT=27018
MONGO_EXPRESS_PORT=8081
REDIS_PORT=6380

# API
API_PORT=3001
API_DEBUG_PORT=9229

# Front-end
WEB_PORT=3000
NEXT_PUBLIC_API_URL=http://localhost:3001

# Which AI coach implementation to bind. `stub` returns fixtures flagged
# `is_stubbed` so the whole product runs with no model. `model` uses
# ModelAiCoachProvider, which throws until it is implemented.
AI_COACH_PROVIDER=stub
