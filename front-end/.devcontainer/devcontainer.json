// For format details, see https://aka.ms/devcontainer.json.
{
  "name": "VentureWise Front-end (Next.js)",

  // ../docker-compose.yml is the *primary* file, so relative paths inside both
  // files resolve against front-end/.
  "dockerComposeFile": ["../docker-compose.yml", "docker-compose.yml"],
  "service": "front-end",

  // The repo root is mounted at /workspaces, so `.git` resolves from here and
  // VS Code's Source Control panel works.
  "workspaceFolder": "/workspaces/front-end",

  // uid 1000, which is what the host's files map to — no chown dance needed,
  // and nothing in .git ends up owned by root.
  "remoteUser": "root",

  // Closing this dev container must not stop the infrastructure the API dev
  // container is also using.
  "shutdownAction": "none",

  "forwardPorts": [3000],
  "portsAttributes": {
    "3000": { "label": "Next.js dev server", "onAutoForward": "openPreview" }
  },

  "customizations": {
    "vscode": {
      "extensions": [
        "dbaeumer.vscode-eslint",
        "esbenp.prettier-vscode",
        "github.copilot-chat",
        "ecmel.vscode-html-css",
        "zignd.html-css-class-completion",
        "xabikos.javascriptsnippets",
        "firsttris.vscode-jest-runner",
        "yzhang.markdown-all-in-one",
        "bradlc.vscode-tailwindcss",
        "gruntfuggly.todo-tree",
        "ms-azuretools.vscode-docker",
        "docker.docker",
        "formulahendry.auto-rename-tag"
      ]
    }
  }
}
