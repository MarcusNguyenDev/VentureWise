# Copy to `front-end/.env`. Both are read by `next dev` and `next build`.

# Where the browser should reach the API.
#
# This is a BROWSER-facing value: the app is client-rendered, so the URL is
# resolved by the visitor's machine, not by the container. In the dev container
# that means localhost — the API is published on the host, and "api:3001" would
# only resolve from inside the compose network.
#
# In production this is the public origin nginx terminates, e.g.
#   API_URL=https://venturewise.example.com
API_URL=http://localhost:3001
