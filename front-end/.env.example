# Copy to `front-end/.env`. Both are read by `next dev` and `next build`.

# Where the browser reaches the API.
#
# LEAVE THIS EMPTY IN PRODUCTION.
#
# The API is served under /api on the same domain by the reverse proxy, so an
# empty value makes the app call /api/... on its own origin — which is correct,
# needs no CORS, and keeps the image portable. This value is inlined into the
# bundle at build time, so a hostname baked in here pins that image to one
# domain forever.
#
#   API_URL=            # production: same origin, behind the proxy
#
# Set it only when the API is genuinely somewhere else — which is the case in
# local development, where it runs on its own port:
API_URL=http://localhost:3001
